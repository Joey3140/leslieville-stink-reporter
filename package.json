{
    "name": "leslieville-stink-reporter",
    "version": "0.1.0",
    "description": "Public odour reporting portal for residents near Toronto's Ashbridges Bay wastewater treatment plant",
    "main": "server.js",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "NODE_ENV=development node server.js",
        "build:fsa": "node scripts/build-fsa-geojson.js"
    },
    "keywords": [
        "toronto",
        "leslieville",
        "ashbridges-bay",
        "civic-tech",
        "odour-reporting"
    ],
    "author": "Joey Drury",
    "license": "MIT",
    "dependencies": {
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.21.2",
        "firebase-admin": "^13.6.0",
        "helmet": "^8.1.0",
        "pino": "^10.3.1",
        "pino-pretty": "^11.2.2",
        "resend": "^4.0.1",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "nodemon": "^3.1.7",
        "proj4": "^2.11.0",
        "puppeteer-core": "^24.42.0"
    }
}
