{
    "version": 2,
    "crons": [
        {
            "path": "/api/cron/alert-check",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/cron/prune-rate-limits",
            "schedule": "0 4 * * *"
        }
    ],
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 60
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server.js"
        }
    ]
}
